# GenArchitect environment.
#
# --- Server/CI only (NOT used by the client app, never in the bundle) ---
# The video refresh script (scripts/fetch-videos.mjs) reads this key for
# YouTube Data API enrichment. RSS discovery works WITHOUT a key.
# In CI, this is provided as the repository secret YOUTUBE_API_KEY — do not
# commit a real key here or anywhere in the repo.
YOUTUBE_API_KEY=REPLACE_ME

# --- Client build vars (VITE_*) — these DO ship in the built bundle ---
#
# Cloudflare Web Analytics beacon token. Optional: when unset, no analytics
# script loads. The token is NOT a secret (it's visible in client HTML to every
# visitor), so it is safe to expose. Set it here for local builds, or in
# Cloudflare Pages → Settings → Environment variables for production.
# Get it from Cloudflare dashboard → Web Analytics → your site → Manage site.
VITE_CF_BEACON_TOKEN=
